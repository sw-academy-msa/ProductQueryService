# 실제 비밀번호·토큰을 기록하지 않는 로컬 예시입니다.
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8082
DB_URL=jdbc:postgresql://localhost:5433/product_query
DB_USERNAME=product_query
DB_PASSWORD=replace-with-generated-query-password
JWT_ISSUER=http://localhost:8080
JWT_AUDIENCE=stockdrop-api
ACCOUNT_JWKS_URI=http://localhost:8080/.well-known/jwks.json
EUREKA_CLIENT_ENABLED=true
EUREKA_DEFAULT_ZONE=http://localhost:8761/eureka/
# Command Outbox는 아직 없으므로 로컬 소비는 명시적으로 활성화합니다.
QUERY_EVENTS_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
QUERY_IMAGES_ENABLED=false
QUERY_IMAGES_LOCAL=true
QUERY_IMAGES_BUCKET=stockdrop-product-images
QUERY_IMAGES_ENDPOINT=http://localhost:9092
QUERY_IMAGES_REGION=ap-northeast-2

# Monitoring의 scripts/Initialize-LocalMonitoring.ps1에서 로컬 수집 토큰을 동기화합니다.
MONITORING_SCRAPE_TOKEN=
